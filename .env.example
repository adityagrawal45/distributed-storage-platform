# Copy this file to .env and fill in real values.
# NEVER commit a real .env file with production secrets to version control.

# --- Application ---
APP_NAME=NimbusFS
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1

# --- Server ---
HOST=0.0.0.0
PORT=8000

# --- Security / JWT ---
# Generate a strong secret: openssl rand -hex 32
JWT_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ISSUER=nimbusfs

# --- CORS / Hosts ---
CORS_ALLOWED_ORIGINS=http://localhost:3000
ALLOWED_HOSTS=*

# --- PostgreSQL ---
POSTGRES_USER=nimbusfs
POSTGRES_PASSWORD=nimbusfs
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=nimbusfs
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_ECHO=false

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_MAX_CONNECTIONS=20

# --- Logging ---
LOG_LEVEL=INFO
LOG_JSON=true

# --- Google Cloud Storage (Phase 3) ---
GCS_PROJECT_ID=nimbusfs-dev
GCS_BUCKET_NAME=nimbusfs-files-dev
# Leave unset in staging/production — Application Default Credentials
# (a workload-identity-bound service account on GKE/Cloud Run) are used
# instead. Only set this for local development, and never commit the
# key file itself.
GCS_CREDENTIALS_PATH=
SIGNED_URL_EXPIRATION_MINUTES=15
MAX_UPLOAD_SIZE_MB=100
# Empty = allow every MIME type except what BLOCKED_EXTENSIONS rejects.
ALLOWED_MIME_TYPES=
BLOCKED_EXTENSIONS=exe,bat,cmd,msi,dll,com,scr,jar,vbs,ps1,sh,app,apk

# --- Server / Instance Identity (Phase 4) ---
# Leave both commented out (NOT set to an empty string — that would
# override the generated default with a literal blank) in real
# deployments: INSTANCE_ID is randomly generated per process, HOSTNAME
# defaults to the OS/container hostname (the pod name on GKE/Cloud Run).
# Uncomment only for local debugging.
# INSTANCE_ID=
# HOSTNAME=
# Baked in at container build time, e.g.:
#   docker build --build-arg GIT_COMMIT=$(git rev-parse HEAD) ...
# and passed through as env vars — never computed at runtime, so a
# running process can prove exactly which build it's serving.
BUILD_VERSION=dev-local
GIT_COMMIT=unknown

# --- Distributed Backend (Phase 4) ---
# Comma-separated list of trusted reverse-proxy IPs whose X-Forwarded-*
# headers are honored for client IP/scheme resolution. "*" trusts any
# proxy — fine behind a locked-down Cloud Load Balancer where the app is
# never internet-reachable directly; pin to real proxy IPs/CIDRs once
# that topology is fixed.
TRUSTED_PROXIES=*

# How long a completed Idempotency-Key response is replayable, and how
# long an in-flight one blocks a concurrent duplicate before it's
# assumed abandoned.
IDEMPOTENCY_KEY_TTL_SECONDS=86400
IDEMPOTENCY_LOCK_TIMEOUT_SECONDS=60

# Redis-backed distributed lock defaults (app/core/distributed_lock.py).
LOCK_DEFAULT_TTL_SECONDS=30
LOCK_ACQUIRE_TIMEOUT_SECONDS=5.0
LOCK_RETRY_INTERVAL_SECONDS=0.1

# Retry policy for transient DB/Redis/Storage failures (startup checks
# and request-path health checks).
RETRY_MAX_ATTEMPTS=3
RETRY_BASE_DELAY_SECONDS=0.2
RETRY_MAX_DELAY_SECONDS=2.0

# If true (recommended), the process refuses to finish startup — and
# therefore never reports ready — when a critical dependency (DB/Redis/
# Storage) is unreachable after retrying. Set to false only for offline
# tooling that imports the app without running its ASGI lifespan.
FAIL_FAST_ON_STARTUP=true

# Ceiling on graceful shutdown; uvicorn's own
# --timeout-graceful-shutdown should be set to a value >= this.
SHUTDOWN_GRACE_PERIOD_SECONDS=10.0

# --- Chunked / Resumable Uploads (Phase 6) ---
# Governs the LARGE-file path (/api/v1/uploads/*), separate from
# MAX_UPLOAD_SIZE_MB above (the simple single-shot /files/upload path).
CHUNK_MIN_SIZE_BYTES=1048576
# Also the per-chunk in-memory buffering ceiling — the server never
# holds more than this many bytes of a chunk in memory at once.
CHUNK_MAX_SIZE_BYTES=268435456
CHUNK_DEFAULT_SIZE_BYTES=8388608
MAX_CHUNKS_PER_UPLOAD=10000
MAX_CHUNKED_UPLOAD_SIZE_GB=100
# How long an idle upload session survives before lazy expiration
# (checked on access, no background sweeper this phase).
UPLOAD_SESSION_EXPIRATION_MINUTES=120

# --- Distributed Redis Caching & Coordination (Phase 7) ---
# Redis connection pool / timeouts. Deliberately shorter than the DB and
# GCS timeouts: Redis is a cache, and a slow cache is worse than none —
# a hung call must fail fast enough that falling back to Postgres is
# still cheaper than waiting.
REDIS_SOCKET_CONNECT_TIMEOUT_SECONDS=2.0
REDIS_SOCKET_TIMEOUT_SECONDS=2.0
REDIS_RETRY_ON_TIMEOUT=true
REDIS_HEALTH_CHECK_INTERVAL_SECONDS=30

# Master cache kill switch. false => CacheService turns every operation
# into a miss/no-op and the app behaves exactly as it did in Phases 1-6
# (Postgres-only). Flip this, not the code, during a cache incident.
CACHE_ENABLED=true
# Global key namespace; `SCAN nimbusfs:*` is a complete inventory of what
# this app owns in a shared Redis instance.
CACHE_KEY_PREFIX=nimbusfs

# Per-entity TTLs (seconds). These are the hard ceiling on staleness if
# an invalidation is ever missed — see app/core/cache/policy.py.
CACHE_TTL_USER_SECONDS=900
CACHE_TTL_FOLDER_SECONDS=300
CACHE_TTL_FOLDER_CHILDREN_SECONDS=300
CACHE_TTL_FOLDER_BREADCRUMBS_SECONDS=300
CACHE_TTL_FILE_SECONDS=300
CACHE_TTL_FILE_VERSIONS_SECONDS=300
CACHE_TTL_SEARCH_SECONDS=90

# Never cache a value bigger than this (one huge value evicts thousands
# of useful small ones), or a search page with more rows than this.
CACHE_MAX_VALUE_BYTES=262144
CACHE_SEARCH_MAX_ITEMS=100

# Cache-stampede (thundering herd) protection: on a miss, one request
# wins a short lock and populates while the others wait BRIEFLY, then
# read through to Postgres anyway. No request ever blocks indefinitely.
CACHE_STAMPEDE_PROTECTION_ENABLED=true
CACHE_STAMPEDE_LOCK_TTL_SECONDS=5.0
CACHE_STAMPEDE_WAIT_SECONDS=0.5
CACHE_STAMPEDE_POLL_INTERVAL_SECONDS=0.02

# Post-invalidation write guard (delayed-double-delete). >0 closes the
# narrow invalidate-before-commit race at the cost of leaving each
# written key cold for this long. Off by default — see
# docs/PHASE_7_REDIS_DESIGN.md before enabling.
CACHE_WRITE_GUARD_SECONDS=1.5

# --- Rate Limiting (Phase 7) ---
RATE_LIMIT_ENABLED=true
# true (recommended): Redis unreachable => ALLOW and log loudly at ERROR.
# Availability beats strict limiting for a file-storage platform; a Redis
# blip must not become a fleet-wide 429 storm. Set false to fail closed.
RATE_LIMIT_FAIL_OPEN=true

# Budgets are `<REQUESTS> per <WINDOW_SECONDS>`, enforced as a token
# bucket: REQUESTS is both the sustained budget and the maximum burst.
RATE_LIMIT_LOGIN_REQUESTS=10
RATE_LIMIT_LOGIN_WINDOW_SECONDS=60
RATE_LIMIT_REGISTER_REQUESTS=5
RATE_LIMIT_REGISTER_WINDOW_SECONDS=300
RATE_LIMIT_METADATA_REQUESTS=300
RATE_LIMIT_METADATA_WINDOW_SECONDS=60
RATE_LIMIT_UPLOAD_INITIATE_REQUESTS=60
RATE_LIMIT_UPLOAD_INITIATE_WINDOW_SECONDS=60
RATE_LIMIT_UPLOAD_COMPLETE_REQUESTS=60
RATE_LIMIT_UPLOAD_COMPLETE_WINDOW_SECONDS=60
RATE_LIMIT_SEARCH_REQUESTS=60
RATE_LIMIT_SEARCH_WINDOW_SECONDS=60
RATE_LIMIT_DEFAULT_REQUESTS=600
RATE_LIMIT_DEFAULT_WINDOW_SECONDS=60

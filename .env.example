# Copy this file to .env and fill in real values.
# NEVER commit a real .env file with production secrets to version control.

# --- Application ---
APP_NAME=NimbusFS
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1

# --- Server ---
HOST=0.0.0.0
PORT=8000

# --- Security / JWT ---
# Generate a strong secret: openssl rand -hex 32
JWT_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ISSUER=nimbusfs

# --- CORS / Hosts ---
CORS_ALLOWED_ORIGINS=http://localhost:3000
ALLOWED_HOSTS=*

# --- PostgreSQL ---
POSTGRES_USER=nimbusfs
POSTGRES_PASSWORD=nimbusfs
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=nimbusfs
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_ECHO=false
# Optional async read-replica URL, e.g.
# postgresql+asyncpg://user:pass@replica-host:5432/nimbusfs
# Leave unset -> get_db_read() transparently falls back to the primary.
DATABASE_READ_REPLICA_URL=

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_MAX_CONNECTIONS=20

# --- Distributed Backend (Phase 4) ---
# Stable per-process identifier surfaced in /health, logs, and the
# X-Server-ID response header. Leave unset in Kubernetes/Cloud Run (the
# platform-assigned hostname is used instead) — only set this for local
# docker-compose demos with multiple app replicas (see docker-compose.yml).
INSTANCE_ID=
# Populated by CI/CD (Docker build args); "dev"/"unknown" locally.
BUILD_VERSION=dev
GIT_COMMIT_SHA=unknown
# Startup dependency checks (DB/Redis/GCS) retry with exponential backoff
# before the process fails fast and refuses to start.
DEPENDENCY_RETRY_ATTEMPTS=3
DEPENDENCY_RETRY_BACKOFF_SECONDS=0.5
DEPENDENCY_RETRY_BACKOFF_MAX_SECONDS=8
# How long graceful shutdown waits for in-flight requests to drain.
GRACEFUL_SHUTDOWN_TIMEOUT_SECONDS=30
# Idempotency-Key support (POST/PUT/PATCH/DELETE with that header).
IDEMPOTENCY_ENABLED=true
IDEMPOTENCY_KEY_TTL_SECONDS=86400
# Default TTL for app.core.distributed_lock.DistributedLock.
DISTRIBUTED_LOCK_DEFAULT_TTL_SECONDS=30
# Rate limiting is a PLACEHOLDER — infrastructure only, off by default.
RATE_LIMIT_ENABLED=false
RATE_LIMIT_REQUESTS_PER_MINUTE=120
# Comma-separated proxy IPs allowed to set X-Forwarded-For/-Proto.
# "*" trusts any peer (fine for the local nginx in docker-compose, NEVER
# for a production deployment reachable directly by the internet).
TRUSTED_PROXIES=
# In-process circuit breaker guarding Redis calls.
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RESET_TIMEOUT_SECONDS=30

# --- Logging ---
LOG_LEVEL=INFO
LOG_JSON=true

# --- Google Cloud Storage (Phase 3) ---
GCS_PROJECT_ID=nimbusfs-dev
GCS_BUCKET_NAME=nimbusfs-files-dev
# Leave unset in staging/production — Application Default Credentials
# (a workload-identity-bound service account on GKE/Cloud Run) are used
# instead. Only set this for local development, and never commit the
# key file itself.
GCS_CREDENTIALS_PATH=
SIGNED_URL_EXPIRATION_MINUTES=15
MAX_UPLOAD_SIZE_MB=100
# Empty = allow every MIME type except what BLOCKED_EXTENSIONS rejects.
ALLOWED_MIME_TYPES=
BLOCKED_EXTENSIONS=exe,bat,cmd,msi,dll,com,scr,jar,vbs,ps1,sh,app,apk

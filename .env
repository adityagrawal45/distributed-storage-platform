# Copy this file to .env and fill in real values.
# NEVER commit a real .env file with production secrets to version control.

# --- Application ---
APP_NAME=NimbusFS
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1

# --- Server ---
HOST=0.0.0.0
PORT=8000

# --- Security / JWT ---
# Generate a strong secret: openssl rand -hex 32
JWT_SECRET_KEY=Ym9gVFBecJbX6hyMpQt7NSouWT2raUvInkqLsfG0dZRAl3814DHK5OCzjEPiwx
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ISSUER=nimbusfs

# --- CORS / Hosts ---
